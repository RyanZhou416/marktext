{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkText",
  "version": "0.17.1",
  "identifier": "com.github.marktext",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MarkText",
        "width": 1280,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "../resources/icons/32x32/icon.png",
      "../resources/icons/128x128/icon.png",
      "../resources/icons/256x256/icon.png",
      "../resources/icons/icon.ico",
      "../resources/icons/icon.png"
    ],
    "resources": [
      "../static/*",
      "../src/muya/themes/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
