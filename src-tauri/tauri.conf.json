{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkText",
  "version": "0.17.1",
  "identifier": "com.github.marktext",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "../resources/icons/32x32/icon.png",
      "../resources/icons/128x128/icon.png",
      "../resources/icons/256x256/icon.png",
      "../resources/icons/icon.ico",
      "../resources/icons/icon.png"
    ],
    "resources": ["../static/*", "../src/muya/themes/*"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkdn", "mkd", "mdwn", "mdtxt", "mdtext"],
        "mimeType": "text/markdown",
        "description": "Markdown Document"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {}
}
