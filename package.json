{
  "name": "marktext",
  "version": "0.17.1",
  "homepage": "https://github.com/marktext/marktext/",
  "description": "Next generation markdown editor",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:info": "tauri info",
    "vite:dev": "vite --config vite.config.mjs",
    "vite:build": "vite build --config vite.config.mjs",
    "vite:preview": "vite preview --config vite.config.mjs",
    "build:clean": "rimraf out dist",
    "e2e": "yarn build && cross-env MARKTEXT_EXIT_ON_ERROR=1 playwright test -c test/e2e/playwright.config.js test/e2e",
    "lint": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter src test",
    "lint:fix": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter --fix src test",
    "test": "yarn run e2e",
    "test:specs": "node -r esm test/specs/commonMark/run.spec.js && node -r esm test/specs/gfm/run.spec.js",
    "build:muya": "cd src/muya && webpack --progress --config webpack.config.js",
    "gen-third-party": "node tools/generateThirdPartyLicense.js",
    "validate-licenses": "node tools/validateLicenses.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "@marktext/file-icons": "^1.0.6",
    "@octokit/rest": "^18.12.0",
