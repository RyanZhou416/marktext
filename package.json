{
  "name": "marktext",
  "version": "0.17.1",
  "homepage": "https://github.com/marktext/marktext/",
  "description": "Next generation markdown editor",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tauri dev --features devtools",
    "build:portable-debug": "tauri build --no-bundle --debug --features devtools",
    "build:portable-release": "tauri build --no-bundle",
    "build:installer-debug": "tauri build --debug --features devtools",
    "build:installer-release": "tauri build",
    "build": "tauri build --no-bundle",
    "tauri:info": "tauri info",
    "vite:dev": "vite --config vite.config.mjs",
    "vite:build": "vite build --config vite.config.mjs",
    "vite:preview": "vite preview --config vite.config.mjs",
    "build:clean": "node -e \"const fs=require('fs'); ['out','dist'].forEach(d => fs.rmSync(d,{recursive:true,force:true}))\"",
    "e2e": "npm run build && cross-env MARKTEXT_EXIT_ON_ERROR=1 playwright test -c test/e2e/playwright.config.js test/e2e",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,json}\" \"test/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,json}\" \"test/**/*.{js,ts}\"",
    "test": "npm run e2e",
    "test:specs": "node test/specs/commonMark/run.spec.js && node test/specs/gfm/run.spec.js",
    "build:muya": "cd src/muya && webpack --progress --config webpack.config.js",
    "gen-third-party": "node tools/generateThirdPartyLicense.js",
    "validate-licenses": "node tools/validateLicenses.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@marktext/file-icons": "^1.0.6",
    "@milkdown/core": "^7.18.0",
    "@milkdown/plugin-history": "^7.18.0",
    "@milkdown/plugin-listener": "^7.18.0",
    "@milkdown/preset-commonmark": "^7.18.0",
    "@milkdown/utils": "^7.18.0",
    "@octokit/rest": "^18.12.0",
    "@popperjs/core": "^2.11.8",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-window-state": "^2.0.0",
    "@vueuse/core": "^14.2.1",
    "codemirror": "^5.65.2",
    "dayjs": "^1.11.0",
    "dom-autoscroller": "^2.3.4",
    "dompurify": "^3.3.1",
    "dragula": "^3.7.3",
    "element-resize-detector": "^1.2.4",
    "eve": "^0.5.4",
    "execall": "^2.0.0",
    "fast-deep-equal": "^3.1.3",
    "flowchart.js": "^1.17.1",
    "fuzzaldrin": "^2.1.0",
    "github-markdown-css": "^3.0.1",
    "html-tags": "^3.2.0",
    "iconv-lite": "^0.6.3",
    "iso-639-1": "^2.1.13",
    "joplin-turndown-plugin-gfm": "^1.0.12",
    "katex": "^0.15.3",
    "mermaid": "^10.0.0",
    "mitt": "^3.0.0",
    "pinia": "^2.1.0",
    "prismjs": "^1.27.0",
    "radix-vue": "^1.9.17",
    "snabbdom": "^3.4.0",
    "snabbdom-to-html": "^7.0.0",
    "turndown": "^7.1.1",
    "underscore": "^1.13.2",
    "unsplash-js": "^7.0.15",
    "vega": "^5.22.1",
    "vega-embed": "^6.20.8",
    "vega-lite": "^5.2.0",
    "vue": "^3.4.0",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.2.0",
    "vue-sonner": "^2.0.9",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@markedjs/html-differ": "^3.0.4",
    "@playwright/test": "^1.21.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^25.2.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "marked": "^1.2.9",
    "neostandard": "^0.12.2",
    "path-browserify": "^1.0.1",
    "playwright": "^1.21.0",
    "postcss": "^8.4.12",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.25.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:marktext/marktext.git"
  },
  "bugs": {
    "url": "https://github.com/marktext/marktext/issues"
  },
  "author": {
    "name": "Jocs",
    "email": "ransixi@gmail.com",
    "url": "https://github.com/Jocs"
  },
  "maintainer": [
    {
      "name": "Jocs",
      "email": "ransixi@gmail.com",
      "url": "https://github.com/Jocs"
    },
    {
      "name": "Felix Häusler",
      "email": "hfelix@protonmail.ch",
      "url": "https://github.com/fxha"
    }
  ],
  "overrides": {
    "vue-i18n": "^11.2.8"
  }
}
